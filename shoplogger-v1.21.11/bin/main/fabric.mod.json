{
	"schemaVersion": 1,
	"id": "shoplogger",
	"version": "${version}",
	"name": "Shop Logger",
	"description": "Logs Snailcraft-style chest shop signs and contents (when you open them) to CSV/Excel.",
	"authors": ["you"],
	"contact": {},
	"license": "MIT",
	"icon": "assets/shoplogger/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.snailtools.shoplogger.ShopLoggerClient"
		]
	},
	"mixins": [
		"shoplogger.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"fabric-api": "*",
		"minecraft": ">=1.21.11",
		"java": ">=21"
	}
}
